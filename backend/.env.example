# Copy values into backend/.env for local development. Never commit secrets.
DATABASE_URL=sqlite:///./catalog.sqlite3
# For Neon, set DATABASE_URL to the pooled URL and this to the direct URL.
DATABASE_URL_UNPOOLED=
AUTO_CREATE_SCHEMA=1
FRONTEND_ORIGINS=http://localhost:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
TMDB_READ_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
RAWG_API_KEY=
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/media-catalog
RESEND_API_KEY=
REPORT_FROM_EMAIL=
ADMIN_EMAIL=
PUBLIC_CATALOG_URL=http://localhost:3000
CATALOG_JOB_TOKEN=
